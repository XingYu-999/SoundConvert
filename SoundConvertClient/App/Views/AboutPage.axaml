<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SoundConvertClient" x:Class="SoundConvertClient.Views.AboutPage" x:DataType="vm:IBridgeView">
  <StackPanel Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
    <Border Classes="card" Padding="36,40" CornerRadius="14"><Grid ColumnDefinitions="168,*" ColumnSpacing="40" MinHeight="260"><Border Width="160" Height="160" CornerRadius="32" Background="{StaticResource AccentStrong}" VerticalAlignment="Center"><TextBlock Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="86" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Spacing="22" VerticalAlignment="Center"><StackPanel Spacing="5"><TextBlock Text="USB 音频桥接工具" FontSize="30" FontWeight="Bold"/><TextBlock Text="USB Audio Bridge" Classes="muted"/></StackPanel><Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="14"><TextBlock Text="版本号" FontSize="16" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Column="1" Text="{Binding AppVersion}" FontSize="16"/><TextBlock Grid.Row="1" Text="主要框架" FontSize="16" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeVersion}" FontSize="16" TextWrapping="Wrap"/><TextBlock Grid.Row="2" Text="开发平台" FontSize="16" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="W5500-EVB-Pico2 · RP2350" FontSize="16"/><TextBlock Grid.Row="3" Text="设计参考" FontSize="16" Foreground="{StaticResource TextSecondary}"/><Button Grid.Row="3" Grid.Column="1" Command="{Binding OpenReferenceCommand}" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" MinHeight="24"><TextBlock Text="github.com/XingYu-999/ControllerForwardingTool" FontSize="16" Foreground="{StaticResource AccentStrong}" TextWrapping="Wrap"/></Button><TextBlock Grid.Row="4" Text="参考许可" FontSize="16" Foreground="{StaticResource TextSecondary}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="MIT License" FontSize="16"/></Grid><StackPanel Spacing="6"><TextBlock Classes="muted" Text="USB 主机声音 → 开发板 → 局域网 → 电脑耳机或扬声器。"/><TextBlock Classes="caption" Text="界面参考代码保留来源版权和许可。第三方组件遵循各自许可证，完整声明随发布文件提供。"/></StackPanel></StackPanel></Grid></Border>
    <Border Classes="card" Padding="24"><StackPanel Spacing="12"><TextBlock Classes="section" Text="开源项目与致谢"/><TextBlock Classes="caption" Text="界面壳、导航尺寸、色彩、图标字体和卡片样式参考 Controller Forwarding Tool 的 MIT 源码，保留原版权与许可声明。"/><Border Classes="deviceRow"><StackPanel Spacing="5"><TextBlock Text="Controller Forwarding Tool" FontWeight="SemiBold"/><TextBlock Text="Copyright © 2026 Controller Forwarding Tool contributors · MIT" Classes="caption"/><TextBlock Text="Views/MainWindow.axaml · OverviewPage.axaml · App.axaml" Classes="caption"/><Button Content="查看参考项目" Command="{Binding OpenReferenceCommand}" HorizontalAlignment="Left"/></StackPanel></Border><Border Classes="deviceRow"><StackPanel Spacing="5"><TextBlock Text="Avalonia / .NET / NAudio" FontWeight="SemiBold"/><TextBlock Text="桌面界面、托管运行时与 Windows 共享音频输出。许可随发布文件与第三方声明提供。" Classes="caption"/></StackPanel></Border><TextBlock Classes="caption" Text="连接提示为本地生成的原创中文语音，不使用 Sony 或其他产品的录音。Windows 系统图标字体由操作系统提供，不重新分发字体文件。"/></StackPanel></Border>
    <Border Classes="card" Padding="24"><StackPanel Spacing="10"><TextBlock Classes="section" Text="验收边界"/><TextBlock Classes="caption" Text="格式声明、USB Host 当前选择、网络有效数据和电脑真实输出分别验证。缓冲水位不是端到端延迟；不同网络、输出设备和负载应按诊断数据重新选择缓冲。"/><TextBlock Classes="caption" Text="详细构建、协议、实机记录与未测试项请查看项目文档和导出的诊断，不以界面上的连接状态代替完整硬件验收。"/></StackPanel></Border>
  </StackPanel>
</UserControl>

