<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SoundConvertClient" xmlns:controls="using:SoundConvertClient.Controls" x:Class="SoundConvertClient.Views.NetworkPage" x:DataType="vm:IBridgeView">
  <StackPanel Spacing="14">
    <Border Classes="card"><StackPanel Spacing="12"><TextBlock Classes="section" Text="设备网卡"/><TextBlock Text="{Binding NetworkLabel}" Classes="caption"/><TextBlock Classes="fieldLabel" Text="地址获取方式"/><controls:NoWheelComboBox ItemsSource="{Binding NetworkModes}" SelectedItem="{Binding NetworkMode}" IsEnabled="{Binding CanEditUsb}" Width="220"/>
    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="14" IsEnabled="{Binding CanEditUsb}"><StackPanel Spacing="6"><TextBlock Classes="fieldLabel" Text="静态 IPv4"/><TextBox Text="{Binding NetworkIp}"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Classes="fieldLabel" Text="前缀长度"/><NumericUpDown Value="{Binding NetworkPrefix}" Minimum="1" Maximum="30"/></StackPanel><StackPanel Grid.Row="1" Spacing="6"><TextBlock Classes="fieldLabel" Text="网关"/><TextBox Text="{Binding NetworkGateway}"/></StackPanel><StackPanel Grid.Row="1" Grid.Column="1" Spacing="6"><TextBlock Classes="fieldLabel" Text="DNS"/><TextBox Text="{Binding NetworkDns}"/></StackPanel></Grid>
    <WrapPanel><Button Classes="primary" Content="保存网卡配置" Command="{Binding ApplyNetworkCommand}" IsEnabled="{Binding CanEditUsb}" Margin="0,0,8,0"/><Button Content="重新读取" Command="{Binding ReadNetworkCommand}" IsEnabled="{Binding IsConnected}"/></WrapPanel><TextBlock Classes="caption" Text="保存时自动停止模拟、连接新地址并确认配置，再恢复模拟。新地址必须可达；未确认时设备会自动回滚。"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="配置结果与恢复"/><TextBlock Text="{Binding NetworkStatus}" Classes="caption"/><TextBlock Text="{Binding PendingTransaction}" Classes="mono"/><WrapPanel><Button Content="查询事务" Command="{Binding QueryTransactionCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,8,0"/><Button Content="确认提交" Command="{Binding ConfirmNetworkCommand}" IsEnabled="{Binding CanManage}" Margin="0,0,8,0"/><Button Content="回滚" Command="{Binding RollbackNetworkCommand}" IsEnabled="{Binding CanManage}"/></WrapPanel></StackPanel></Border>
    <Expander Header="UDP 广播恢复"><Border Classes="card" Margin="0,10,0,0"><StackPanel Spacing="10"><TextBlock Classes="caption" Text="先通过UDP 广播搜索选中设备，可恢复没有有效 IP 的虚拟声卡。不会修改电脑网卡 IP。"/><WrapPanel><Button Content="UDP 广播搜索" Command="{Binding DiscoverBroadcastCommand}" IsEnabled="{Binding CanDiscoverBroadcast}" ToolTip.Tip="{Binding UdpDiscoveryHint}" ToolTip.ShowOnDisabled="True" Margin="0,0,8,8"/><Button Content="UDP 广播试用" Command="{Binding ApplyBroadcastCommand}" Margin="0,0,8,8"/><Button Content="UDP 广播查询结果" Command="{Binding QueryBroadcastCommand}" Margin="0,0,8,8"/><Button Content="UDP 广播确认" Command="{Binding ConfirmBroadcastCommand}" Margin="0,0,8,8"/><Button Content="UDP 广播回滚" Command="{Binding RollbackBroadcastCommand}"/></WrapPanel></StackPanel></Border></Expander>
  </StackPanel>
</UserControl>
