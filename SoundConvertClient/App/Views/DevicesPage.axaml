<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SoundConvertClient" xmlns:controls="using:SoundConvertClient.Controls" xmlns:bridge="using:UsbAudioBridge" xmlns:views="using:SoundConvertClient.Views" x:Class="SoundConvertClient.Views.DevicesPage" x:DataType="vm:IBridgeView">
  <StackPanel Spacing="16" MaxWidth="1440" HorizontalAlignment="Stretch">
    <StackPanel Spacing="5"><TextBlock Classes="title" Text="虚拟声卡"/><TextBlock Classes="muted" Text="搜索并连接开发板，配置 USB 声卡。"/></StackPanel>
    <Border Classes="warning" IsVisible="{Binding HasPendingNetworkTransaction}"><StackPanel Spacing="10"><TextBlock Classes="section" Text="网络配置待确认"/><TextBlock Text="{Binding PendingTransaction}" Classes="mono"/><TextBlock Text="{Binding NetworkStatus}" TextWrapping="Wrap"/><TextBlock Text="恢复操作使用已保存的设备身份和网卡，无需保留搜索结果。" Classes="caption"/><WrapPanel><Button Content="查询事务" Command="{Binding QueryTransactionCommand}" Margin="0,0,8,8"/><Button Content="确认网络配置" Command="{Binding ConfirmNetworkCommand}" Margin="0,0,8,8"/><Button Content="回滚网络配置" Command="{Binding RollbackNetworkCommand}" Margin="0,0,8,8"/></WrapPanel><Expander Header="UDP 广播恢复（TCP 不可达时）"><WrapPanel Margin="0,8,0,0"><Button Content="UDP 广播查询" Command="{Binding QueryBroadcastCommand}" Margin="0,0,8,8"/><Button Content="UDP 广播确认" Command="{Binding ConfirmBroadcastCommand}" Margin="0,0,8,8"/><Button Content="UDP 广播回滚" Command="{Binding RollbackBroadcastCommand}" Margin="0,0,8,8"/></WrapPanel></Expander></StackPanel></Border>
    <Border Name="DeviceConnectionCard" Classes="card"><StackPanel Spacing="12">
      <StackPanel Spacing="5"><TextBlock Classes="section" Text="设备连接"/><TextBlock Classes="caption" Text="{Binding HeaderStatus}"/></StackPanel>
      <StackPanel Spacing="6"><TextBlock Classes="fieldLabel" Text="搜索网卡"/><Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10"><controls:NoWheelComboBox x:Name="SearchAdapterComboBox" ItemsSource="{Binding SearchAdapters}" SelectedItem="{Binding SelectedSearchAdapter}" PlaceholderText="选择用于发现和音频的电脑网卡" HorizontalAlignment="Stretch" IsEnabled="{Binding CanSelectSearchAdapter}" AutomationProperties.Name="搜索网卡"><controls:NoWheelComboBox.ItemTemplate><DataTemplate x:DataType="bridge:NetworkAdapterInfo"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></controls:NoWheelComboBox.ItemTemplate></controls:NoWheelComboBox><Button Grid.Column="1" Content="刷新网卡" Command="{Binding RefreshSearchAdaptersCommand}" IsEnabled="{Binding CanSelectSearchAdapter}"/><Button Grid.Column="2" Content="搜索设备" Command="{Binding DiscoverCommand}" IsEnabled="{Binding CanDiscover}"/><Button Grid.Column="3" Name="ManualConnectButton" Content="手动连接" Command="{Binding ManualConnectCommand}" ToolTip.Tip="通过所选网卡输入 IPv4 和 TCP 端口"/></Grid><WrapPanel><Button Name="CancelSearchButton" Content="取消搜索" Command="{Binding CancelSearchCommand}" IsVisible="{Binding IsDiscovering}" Margin="0,0,10,0"/><Button Name="CancelConnectionButton" Content="取消连接" Command="{Binding CancelConnectionCommand}" IsVisible="{Binding CanCancelConnection}"/></WrapPanel><TextBlock Classes="caption" Text="{Binding SearchAdapterSummary}"/></StackPanel>

      <Border Classes="inset" IsVisible="{Binding IsConnected}"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="12"><StackPanel Spacing="5"><TextBlock Text="{Binding ConnectedName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ConnectedAddress}"/><TextBlock Text="先断开当前设备后，才能连接其他设备或保存网络配置。" Classes="caption"/></StackPanel><Button Name="ConnectionToggleButton" Grid.Column="1" Classes="connection" Classes.connected="{Binding IsConnected}" Content="{Binding ConnectionButtonText}" Command="{Binding ToggleConnectionCommand}" IsEnabled="{Binding CanToggleConnection}" MinWidth="130" VerticalAlignment="Center"/></Grid></Border>
      <TextBlock Classes="caption" Text="{Binding DiscoverySummary}"/>
      <ListBox Name="DiscoveredDevicesList" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinHeight="75" MaxHeight="300"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:DeviceRow"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><StackPanel Spacing="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Detail}" Classes="caption"/><TextBlock Text="{Binding Identity}" Classes="mono"/></StackPanel><Button Grid.Column="1" Content="连接" Command="{ReflectionBinding $parent[UserControl].DataContext.ConnectDeviceCommand}" CommandParameter="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="2" Name="ConfigureDeviceButton" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="40" Height="40" Padding="0" Command="{ReflectionBinding $parent[UserControl].DataContext.ConfigureDeviceCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.Name="配置此设备的 IP 地址" ToolTip.Tip="查看或配置此设备的 IP 地址"><Path Width="22" Height="22" Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.7" StrokeJoin="Round" Data="M 9,2 L 13,2 L 14,5 L 17,6 L 20,5 L 22,9 L 20,11 L 20,14 L 22,16 L 20,20 L 17,19 L 14,20 L 13,23 L 9,23 L 8,20 L 5,19 L 2,20 L 0,16 L 2,14 L 2,11 L 0,9 L 2,5 L 5,6 L 8,5 Z M 15,12.5 A 4,4 0 1,1 7,12.5 A 4,4 0 1,1 15,12.5"/></Button></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBlock Classes="caption" Text="连接固定使用当前网卡。IP 齿轮通过同一网卡发送 UDP 广播，核对设备身份后配置地址。"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="开发板状态监视"/><TextBlock Text="{Binding MonitorStatus}" Classes="caption"/><Expander Header="详细状态快照"><TextBox Text="{Binding MonitorDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="420"/></Expander></StackPanel></Border>
    <views:UsbPage/>
    <Border Name="PortStatusCard" Classes="card"><StackPanel Spacing="8">
      <TextBlock Classes="section" Text="端口状态"/>
      <TextBlock Text="{Binding ControlPortLabel, StringFormat=控制：{0} · 设备发现 UDP 49160}" Classes="caption"/>
      <TextBlock Text="{Binding PlaybackPorts, StringFormat=声音输出：{0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding CapturePorts, StringFormat=声音输入：{0}}" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding UdpPortNegotiationStatus}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel></Border>
  </StackPanel>
</UserControl>

