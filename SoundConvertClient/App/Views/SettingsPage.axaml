<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SoundConvertClient" xmlns:controls="using:SoundConvertClient.Controls" x:Class="SoundConvertClient.Views.SettingsPage" x:DataType="vm:IBridgeView">
  <StackPanel Spacing="16" MaxWidth="1440" HorizontalAlignment="Stretch"><TextBlock Classes="title" Text="设置"/><TextBlock Classes="caption" Text="启动、后台连接、监视与本地数据。"/>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="启动与窗口"/><CheckBox Content="登录 Windows 后启动本应用" IsChecked="{Binding StartAtLogin}"/><TextBlock Classes="caption" Text="仅修改当前用户的启动入口。移动软件目录后请重新保存设置。"/><CheckBox Content="启动后收起到系统托盘" IsChecked="{Binding StartInTray}"/><CheckBox Content="最小化时收起到系统托盘" IsChecked="{Binding MinimizeToTray}"/><CheckBox Content="关闭窗口时收起到托盘" IsChecked="{Binding CloseToTray}"/><TextBlock Classes="caption" Text="收起到托盘时软件仍在运行，可以继续播放。取消后关闭窗口会停止播放、麦克风和后台，再退出软件。"/><Button Classes="primary" Content="保存软件设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left"/><TextBlock Classes="caption" Text="{Binding Message}"/></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="自动连接"/><CheckBox x:Name="AutoReconnectCheckBox" Content="与虚拟声卡意外断链后自动重连" IsChecked="{Binding AutoReconnectEnabled}"/><TextBlock Classes="caption" Text="默认开启，修改立即保存。仅重连已成功连接的同一设备和原网卡，失败后逐步延长间隔；停止播放时也有效。手动断开、取消连接或退出软件会停止重连。" TextWrapping="Wrap"/><CheckBox x:Name="AutoConnectCheckBox" Content="后台启动时自动连接上一次成功管理的设备" IsChecked="{Binding AutoConnectCurrent}" IsEnabled="{Binding CanConfigureAutoConnect}"/><TextBlock Classes="caption" Text="默认开启。首次成功连接后记录目标；连接其他设备成功后更新。关闭此项会取消未完成的自动连接，并保留最近设备。"/><TextBlock Classes="caption" Text="{Binding AutoConnectSummary}"/><TextBlock Classes="caption" Text="仅在原网卡按设备唯一 ID 尝试，不接管旧 IP 上的其他设备。重开界面不会重新自动连接；手动断开后等待下一次主动连接。"/></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="设备状态监视"/><TextBlock Classes="caption" Text="软件运行期间，连接后后台自动监视；退出软件后停止。此间隔用于板卡状态，接收电平读取本地缓存。"/><Grid ColumnDefinitions="Auto,*" ColumnSpacing="12"><TextBlock Text="采样间隔（秒）" VerticalAlignment="Center"/><controls:NoWheelComboBox Name="MonitorIntervalSelector" Grid.Column="1" ItemsSource="{Binding MonitorIntervals}" SelectedItem="{Binding MonitorIntervalSeconds}" Width="140" HorizontalAlignment="Left" AutomationProperties.Name="设备状态采样间隔秒"/></Grid><TextBlock Text="{Binding MonitorStatus}" Classes="caption"/></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="连接行为"/><CheckBox Content="播放连接与断开语音提示" IsChecked="{Binding ConnectionAnnouncementEnabled}"/><TextBlock Classes="caption" Text="通过当前电脑输出播放。停止输出、音源暂停或退出软件不会播报断开；自动恢复成功不重复播报。"/><TextBlock Classes="caption" Text="管理连接成功后自动开始输出，只读会话不接管其他管理端。开始输出不隐式启动已停止的 USB 模拟。"/><TextBlock Classes="caption" Text="Host 音量键、声卡内部音量、Windows 输出音量和本地播放增益各自独立。"/></StackPanel></Border>
    <Border Name="UdpPortSettingsCard" Classes="card"><StackPanel Spacing="12">
      <TextBlock Classes="section" Text="UDP 音频端口"/>
      <TextBlock Classes="caption" Text="关闭“自动”后可输入端口，默认使用上次自动协商值。手动范围 1024–65535，同一端的输出与输入端口不能相同。" TextWrapping="Wrap"/>
      <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="10">
        <TextBlock Grid.Column="1" Classes="fieldLabel" Text="虚拟声卡 UDP"/><TextBlock Grid.Column="2" Classes="fieldLabel" Text="本软件 UDP"/>
        <TextBlock Grid.Row="1" Text="声音输出" VerticalAlignment="Center"/>
        <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"><ToggleSwitch Name="BoardPlaybackUdpPortAutomaticSwitch" OnContent="自动" OffContent="手动" IsChecked="{Binding BoardPlaybackUdpPortAutomatic}" VerticalAlignment="Center" AutomationProperties.Name="虚拟声卡播放 UDP 自动协商"/><TextBox Name="BoardPlaybackUdpPortBox" Grid.Column="1" Text="{Binding BoardPlaybackUdpPortNumber}" IsEnabled="{Binding !BoardPlaybackUdpPortAutomatic}" PlaceholderText="1024–65535" MinWidth="96" AutomationProperties.Name="虚拟声卡播放 UDP 端口"/></Grid>
        <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10"><ToggleSwitch Name="SoftwarePlaybackUdpPortAutomaticSwitch" OnContent="自动" OffContent="手动" IsChecked="{Binding SoftwarePlaybackUdpPortAutomatic}" VerticalAlignment="Center" AutomationProperties.Name="本软件播放 UDP 自动协商"/><TextBox Name="SoftwarePlaybackUdpPortBox" Grid.Column="1" Text="{Binding SoftwarePlaybackUdpPortNumber}" IsEnabled="{Binding !SoftwarePlaybackUdpPortAutomatic}" PlaceholderText="1024–65535" MinWidth="96" AutomationProperties.Name="本软件播放 UDP 端口"/></Grid>
        <TextBlock Grid.Row="2" Text="声音输入" VerticalAlignment="Center"/>
        <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10"><ToggleSwitch Name="BoardCaptureUdpPortAutomaticSwitch" OnContent="自动" OffContent="手动" IsChecked="{Binding BoardCaptureUdpPortAutomatic}" VerticalAlignment="Center" AutomationProperties.Name="虚拟声卡麦克风 UDP 自动协商"/><TextBox Name="BoardCaptureUdpPortBox" Grid.Column="1" Text="{Binding BoardCaptureUdpPortNumber}" IsEnabled="{Binding !BoardCaptureUdpPortAutomatic}" PlaceholderText="1024–65535" MinWidth="96" AutomationProperties.Name="虚拟声卡麦克风 UDP 端口"/></Grid>
        <Grid Grid.Row="2" Grid.Column="2" ColumnDefinitions="Auto,*" ColumnSpacing="10"><ToggleSwitch Name="SoftwareCaptureUdpPortAutomaticSwitch" OnContent="自动" OffContent="手动" IsChecked="{Binding SoftwareCaptureUdpPortAutomatic}" VerticalAlignment="Center" AutomationProperties.Name="本软件麦克风 UDP 自动协商"/><TextBox Name="SoftwareCaptureUdpPortBox" Grid.Column="1" Text="{Binding SoftwareCaptureUdpPortNumber}" IsEnabled="{Binding !SoftwareCaptureUdpPortAutomatic}" PlaceholderText="1024–65535" MinWidth="96" AutomationProperties.Name="本软件麦克风 UDP 端口"/></Grid>
      </Grid>
      <Button Content="保存端口设置" Command="{Binding SaveUdpPortsCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding UdpPortSettingsStatus}" Classes="caption" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding UdpPortNegotiationStatus}" Classes="caption" TextWrapping="Wrap"/>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="配置与日志"/><TextBlock Classes="caption" Text="当前用户的设置、最近设备与日志，升级保留。"/><SelectableTextBlock Text="{Binding UserDataDirectory}" TextWrapping="Wrap"/><WrapPanel><Button Content="打开目录" Command="{Binding OpenDataCommand}" Margin="0,0,8,8"/><Button Content="导出诊断" Command="{Binding ExportCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Classes="caption" Text="手动编辑配置前请先退出应用。未完成的网络事务仍可从虚拟声卡页查询、确认或回滚。"/></StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="section" Text="界面与后台"/><WrapPanel><Button Content="收起到托盘" Command="{Binding HideCommand}" Margin="0,0,8,8"/><Button Content="退出应用" Command="{Binding ExitCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Classes="caption" Text="退出应用会停止播放、麦克风和控制连接，并结束后台；不提供退出后继续播放的选项。"/></StackPanel></Border>
  </StackPanel>
</UserControl>
