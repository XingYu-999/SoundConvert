<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SoundConvertClient" x:Class="SoundConvertClient.Views.LogsPage" x:DataType="vm:IBridgeView">
  <StackPanel Spacing="14"><StackPanel Spacing="5"><TextBlock Classes="title" Text="日志"/><TextBlock Classes="caption" Text="查看连接、播放和配置阶段；界面保留最近 200 条，完整日志写入当前用户目录。"/></StackPanel><Border Classes="card"><StackPanel Spacing="12"><WrapPanel><Button Classes="primary" Content="导出诊断" Command="{Binding ExportCommand}" Margin="0,0,8,8"/><Button Content="读取板端统计" Command="{Binding StatsCommand}" IsEnabled="{Binding IsConnected}" Margin="0,0,8,8"/><Button Content="打开日志目录" Command="{Binding OpenDataCommand}" Margin="0,0,8,8"/><Button Content="清空界面" Command="{Binding ClearLogsCommand}" Margin="0,0,8,8"/></WrapPanel><TextBlock Classes="caption" Text="导出仅含状态和统计，不含会话标记或音频内容。清空界面不会删除磁盘日志。"/><ScrollViewer MaxHeight="500"><ItemsControl ItemsSource="{Binding LogEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:UiLogEntry"><Grid ColumnDefinitions="80,*" ColumnSpacing="12" Margin="0,7"><TextBlock Text="{Binding Time}" Classes="caption"/><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel></Border><Expander Header="最近读取的设备诊断"><Border Classes="card" Margin="0,10,0,0"><TextBox Text="{Binding DeviceInfo}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="240" MaxHeight="520" FontFamily="Cascadia Mono, Consolas"/></Border></Expander></StackPanel>
</UserControl>
