   return true;
 }
+
+bool tud_audio_n_get_feedback_state(uint8_t func_id, audio_feedback_state_t* state) {
+  TU_VERIFY(state && func_id < CFG_TUD_AUDIO && _audiod_fct[func_id].p_desc != NULL);
+  audiod_function_t* audio = &_audiod_fct[func_id];
+  state->value_q16 = audio->feedback.value;
+  state->method = audio->feedback.compute_method;
+  state->fifo_average_bytes = 0;
+  state->fifo_threshold_bytes = 0;
+  if (state->method == AUDIO_FEEDBACK_METHOD_FIFO_COUNT) {
+    state->fifo_average_bytes = (uint16_t)(audio->feedback.compute.fifo_count.fifo_lvl_avg >> 16);
+    state->fifo_threshold_bytes = audio->feedback.compute.fifo_count.fifo_lvl_thr;
+  }
+  return true;
+}
